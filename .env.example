# ==============================================================================
# Local Asynchronous OCR Pipeline Configuration (.env)
# ==============================================================================

# --- Runtime Backend ("mlx" for Apple Silicon macOS, "llamacpp" for Linux/Docker) ---
OCR_BACKEND=mlx

# --- MLX Model Configuration (macOS Apple Silicon) ---
MLX_MODEL_ID=mlx-community/Unlimited-OCR-2-8bit
MLX_MODEL_DIR=./models/Unlimited-OCR-2-8bit
HF_HOME=./models/hf_cache
MLX_MAX_TOKENS=8192
MLX_TEMPERATURE=0.0

# --- Multi-Page Batching & PDF Configuration ---
# Number of PDF pages processed in a single forward pass by Unlimited-OCR-2-8bit
DEFAULT_BATCH_SIZE=4
PDF_MAX_PAGES=40
PDF_DPI=150

# --- Application & Server Ports ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- PostgreSQL Database (matches infra/docker-compose.yml) ---
POSTGRES_USER=ocr
POSTGRES_PASSWORD=ocr
POSTGRES_DB=ocr_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ocr:ocr@localhost:5432/ocr_db

# --- Adminer Web UI ---
ADMINER_PORT=8081

# --- Inngest Dev Server ---
INNGEST_PORT=8288
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288
INNGEST_EVENT_KEY=local

# --- llama.cpp Server (Linux / Docker Desktop Fallback) ---
LLAMACPP_BASE_URL=http://localhost:8080
LLAMACPP_PORT=8080
LLAMACPP_MODEL_FILE=unlimited-ocr-2.gguf
