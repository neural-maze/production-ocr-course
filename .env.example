# Copy to .env and fill in the two required values: cp .env.example .env
# Every variable here can also be overridden per command: make deploy IMAGE_TAG=v2

# --- Required ---
SUBSCRIPTION_ID=<YOUR_SUBSCRIPTION_ID>
# Must be globally unique, 5-50 lowercase alphanumeric characters
ACR_NAME=<your-unique-acr-name>

# --- Optional (defaults shown) ---
# LOCATION=francecentral
# RESOURCE_GROUP=ocr-course-rg
# AKS_NAME=aks-ocr-course
# IMAGE_TAG=latest

# Node pool VM sizes (must have quota for these in LOCATION, see docs/azure_gpu_prereqs.md)
# GPU_VM_SIZE=Standard_NC24ads_A100_v4
# T4_VM_SIZE=Standard_NC16as_T4_v3
# CPU_VM_SIZE=Standard_D8ds_v6

# Azure API Management (week 6, optional)
# APIM_NAME=apim-ocr-service
# APIM_SKU=Developer
# APIM_PUBLISHER_EMAIL=admin@yourcompany.com
# APIM_PUBLISHER_NAME=OCR Team
# APIM_SUBNET_PREFIX=10.225.0.0/27
